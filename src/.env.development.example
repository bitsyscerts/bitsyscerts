# BitsysCerts developer-mode variables for a source checkout.
# Copy this file to src/.env when running certsapi or ctpool from the monorepo.
#
# Developer mode assumes the repository structure exists, editable installs are
# in use, and contributors run commands from src/api, src/ctpool, and src/app.
# It does not assume Docker Compose container paths or VS Code-specific paths.
# Run `ctpool stats-snapshot` and `ctpool maintenance` once after bootstrap when
# you want the dashboard to show current operator status immediately.

# ── Database ─────────────────────────────────────────────────────────────────
# Point this at your development PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://bitsyscerts:CHANGEME@127.0.0.1:5432/bitsyscerts

# Optional advanced override for external PostgreSQL deployments where the
# application role cannot create/drop databases.
# DATABASE_ADMIN_URL=postgresql+psycopg://postgres:CHANGEME@127.0.0.1:5432/postgres

# Optional integration-test database. pytest defaults to deriving
# <DATABASE_URL database>_test when this is unset.
# BITSYSCERTS_TEST_DATABASE_URL=postgresql+psycopg://bitsyscerts:CHANGEME@127.0.0.1:5432/bitsyscerts_test

# ── Shared developer defaults ────────────────────────────────────────────────
LOG_LEVEL=INFO
BITSYSCERTS_EXPOSE_STATS_API=true
BITSYSCERTS_BOOTSTRAP_PROFILE=lite
CT_BACKFILL_DAYS=30
CT_BACKFILL_DISPATCH_MODE=per-log
BITSYSCERTS_ENABLE_SCHEDULED_AUDIT=false
CT_DISK_CHECK_PATH=/

# ── Frontend announcement banner (optional) ─────────────────────────────────
# In developer mode (npm run dev), Vite reads VITE_* variables from .env at
# dev-server startup. Set these to preview the banner locally.
# For Docker Compose deployments, use BANNER_* (no VITE_ prefix) instead;
# see .env.compose.example.
#
# VITE_BANNER_VISIBLE=false
# VITE_BANNER_TEXT="This is a demo instance. Please be a responsible netizen!"
# VITE_BANNER_SEVERITY=info          # info | warning | error | success
# VITE_BANNER_ICON=InfoCircle        # InfoCircle | AlertTriangle | AlertCircle | CircleCheck | Speakerphone

# ── Optional faster feedback overrides ───────────────────────────────────────
# CT_TAIL_INTERVAL_SECONDS=60
# CT_STATS_HEAVY_REFRESH_SECONDS=60
# CT_MAINTENANCE_INTERVAL_SECONDS=300
