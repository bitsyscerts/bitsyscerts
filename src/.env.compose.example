# BitsysCerts Docker Compose runtime variables.
# Copy this file to .env in the same directory as docker-compose.yml.
#
# Preferred operator flow:
#   cp .env.compose.example .env
#   ./server-deploy.sh
#
# Manual equivalent:
#   cp .env.compose.example .env
#   docker compose up -d postgres
#   docker compose run --rm migrate ctpool apply-migrations
#   docker compose run --rm migrate ctpool sync-logs
#   docker compose run --rm migrate ctpool stats-snapshot
#   docker compose run --rm migrate ctpool maintenance
#   docker compose up -d
#
# The deploy scripts run the same bootstrap sequence automatically. If the
# dashboard still says no snapshot yet after startup, run:
#   docker compose run --rm migrate ctpool stats-snapshot

# ── Database ─────────────────────────────────────────────────────────────────
# Use the bundled postgres service by default.
DATABASE_URL=postgresql+psycopg://bitsyscerts:CHANGEME@postgres:5432/bitsyscerts

# Optional advanced override for external PostgreSQL deployments where the
# application role cannot create/drop databases.
# DATABASE_ADMIN_URL=postgresql+psycopg://postgres:CHANGEME@postgres:5432/postgres

# Password for the bundled postgres service. Must match DATABASE_URL above.
POSTGRES_PASSWORD=CHANGEME

# ── Images and logging ───────────────────────────────────────────────────────
IMAGE_TAG=latest
LOG_LEVEL=INFO
FRONTEND_PORT=80

# ── Shared local/operator defaults ──────────────────────────────────────────
# The bundled dashboard reads /v1/stats, so keep operator stats enabled unless
# you intentionally hide them behind a gateway or external access control.
BITSYSCERTS_EXPOSE_STATS_API=true

# Bootstrap defaults are applied only on first startup.
BITSYSCERTS_BOOTSTRAP_PROFILE=lite
CT_BACKFILL_DAYS=30
CT_BACKFILL_DISPATCH_MODE=per-log

# Deep scheduled audit remains opt-in; the maintenance loop still runs prune.
BITSYSCERTS_ENABLE_SCHEDULED_AUDIT=false

# Workers measure free disk space on the PostgreSQL data volume mount.
CT_DISK_CHECK_PATH=/data/pgcheck

# ── Optional tuning overrides ────────────────────────────────────────────────
# CT_TAIL_INTERVAL_SECONDS=300
# CT_DEFAULT_BATCH_SIZE=256
# CT_MAX_BATCH_SIZE=1024
# CT_HTTP_TIMEOUT_SECONDS=30
# CT_MIN_FREE_DISK_GB=50
# CT_CRITICAL_FREE_DISK_GB=20
# CT_STATS_HEAVY_REFRESH_SECONDS=300
# CT_MAINTENANCE_INTERVAL_SECONDS=3600
