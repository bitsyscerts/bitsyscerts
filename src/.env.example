# BitsyCerts environment variables — copy this file to .env and fill in values.
# Never commit .env to version control.

# ── Database ─────────────────────────────────────────────────────────────────
# Full async-compatible PostgreSQL DSN.
# If using the bundled postgres service, use the service name as the host:
#   postgresql+psycopg://bitsyscerts:<password>@postgres:5432/bitsyscerts
DATABASE_URL=postgresql+psycopg://bitsyscerts:CHANGEME@postgres:5432/bitsyscerts

# Optional advanced override: only needed when the application role in
# DATABASE_URL cannot create/drop databases, such as shared or managed
# PostgreSQL. The bundled compose postgres service uses a single app role by
# default, so DATABASE_ADMIN_URL is usually unnecessary.
# DATABASE_ADMIN_URL=postgresql+psycopg://postgres:CHANGEME@postgres:5432/postgres

# Password for the bundled postgres service (must match DATABASE_URL above).
POSTGRES_PASSWORD=CHANGEME

# ── Docker image ──────────────────────────────────────────────────────────────
# Pin to a specific digest/tag in production, e.g. sha256:abc123 or v1.2.3.
# Leave as "latest" for rolling deploys from main.
IMAGE_TAG=latest

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Port exposed by the frontend Nginx container on the host.
FRONTEND_PORT=80

# ── CT log ingestion tuning (optional, defaults are shown) ───────────────────
# CT_BACKFILL_DAYS=180
# CT_TAIL_INTERVAL_SECONDS=300
# CT_DEFAULT_BATCH_SIZE=256
# CT_MAX_BATCH_SIZE=1024
# CT_HTTP_TIMEOUT_SECONDS=30
# CT_MIN_FREE_DISK_GB=50
# CT_CRITICAL_FREE_DISK_GB=20
# CT_DISK_CHECK_PATH=/data/pgcheck   # path where postgres_data volume is mounted in workers

# ── Storage profile (bootstrap defaults — applied only on first startup) ─────
# Profile controls default retention windows and certificate storage mode.
# Valid profiles: lite (default), standard, research, archive, custom
# BITSYSCERTS_BOOTSTRAP_PROFILE=lite
#
# Override individual retention fields when using the "custom" profile:
# BITSYSCERTS_BOOTSTRAP_CERT_STORAGE_MODE=none
# BITSYSCERTS_BOOTSTRAP_HOSTNAME_RETENTION_MODE=forever
# BITSYSCERTS_BOOTSTRAP_BACKFILL_DAYS=30
# BITSYSCERTS_BOOTSTRAP_CERT_RETENTION_DAYS=1
# BITSYSCERTS_BOOTSTRAP_OBSERVATION_RETENTION_DAYS=7
# BITSYSCERTS_BOOTSTRAP_ENTRY_OUTCOME_RETENTION_DAYS=7
# BITSYSCERTS_BOOTSTRAP_METRICS_RETENTION_DAYS=14
#
# How often workers reload settings from the database (seconds, default 60):
# BITSYSCERTS_SETTINGS_REFRESH_SECONDS=60
