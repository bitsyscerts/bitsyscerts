# Required
DATABASE_URL=postgresql+psycopg://ctpool:CHANGEME@localhost:5432/ctpool

# Optional advanced override: only needed when the application role in
# DATABASE_URL cannot create/drop databases. The local dev bootstrap script
# grants CREATEDB to `ctpool`, so DATABASE_ADMIN_URL is usually unnecessary.
# DATABASE_ADMIN_URL=postgresql+psycopg://postgres:CHANGEME@localhost:5432/postgres
# Use unique credentials; do not reuse example passwords.

# Ingestion behavior
# CT_BACKFILL_DAYS: how far back (in days) the backfill worker seeds new
#   ranges when a CT log is first encountered.  The worker estimates a pivot
#   index so only the most-recent portion of history is fetched initially;
#   older history is seeded from index 0 on subsequent runs (when days=0 or
#   when the full range has not yet been covered).
#   Set to 0 to seed the complete history of every log from the start.
#   Default: 180  (≈6 months; covers the 90-day ACME renewal window with
#   headroom for certificate chains issued before the subscriber's first run)
CT_BACKFILL_DAYS=180
CT_TAIL_INTERVAL_SECONDS=300
CT_DEFAULT_BATCH_SIZE=256
CT_MAX_BATCH_SIZE=1024

# Disk safety
CT_MIN_FREE_DISK_GB=50
CT_CRITICAL_FREE_DISK_GB=20

# HTTP behavior
CT_HTTP_TIMEOUT_SECONDS=30
CT_MAX_RETRIES=5
CT_BACKOFF_MAX_SECONDS=300

# Logging
LOG_LEVEL=INFO

# Optional tldextract cache override (must be writable if set)
# If unset, ctpool chooses a writable cache path automatically.
# CT_TLDEXTRACT_CACHE_DIR=/tmp/ctpool-tldextract-cache
