# BitsysCerts local Python runtime variables.
# Copy this file to .env in the directory where you run certsapi or ctpool.
#
# This mode does not assume Docker Compose, a source-mounted repository, or a
# process supervisor. Start the API, workers, stats snapshotter, and
# maintenance loop explicitly.
#
# Local Python mode does not auto-seed the first stats snapshot or maintenance
# pass. Run `ctpool stats-snapshot` and `ctpool maintenance` once after
# bootstrap, and re-run `ctpool stats-snapshot` if the dashboard still says no
# snapshot yet.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL is recommended for sustained ingestion. SQLite is not currently
# supported by the packaged runtime.
DATABASE_URL=postgresql+psycopg://bitsyscerts:CHANGEME@127.0.0.1:5432/bitsyscerts

# Optional advanced override for external PostgreSQL deployments where the
# application role cannot create/drop databases.
# DATABASE_ADMIN_URL=postgresql+psycopg://postgres:CHANGEME@127.0.0.1:5432/postgres

# Optional integration-test database. pytest defaults to deriving
# <DATABASE_URL database>_test when this is unset.
# BITSYSCERTS_TEST_DATABASE_URL=postgresql+psycopg://bitsyscerts:CHANGEME@127.0.0.1:5432/bitsyscerts_test

# ── Shared local/operator defaults ──────────────────────────────────────────
LOG_LEVEL=INFO
BITSYSCERTS_EXPOSE_STATS_API=true
BITSYSCERTS_BOOTSTRAP_PROFILE=lite
CT_BACKFILL_DAYS=30
CT_BACKFILL_DISPATCH_MODE=per-log
BITSYSCERTS_ENABLE_SCHEDULED_AUDIT=false

# Local Python runs should inspect the host filesystem directly rather than the
# compose-only /data/pgcheck mount used inside containers.
CT_DISK_CHECK_PATH=/

# ── Optional tuning overrides ────────────────────────────────────────────────
# APP_NAME=BitsyCerts API
# APP_VERSION=0.1.0
# DEFAULT_PAGE_LIMIT=50
# MAX_PAGE_LIMIT=200
# CT_TAIL_INTERVAL_SECONDS=300
# CT_DEFAULT_BATCH_SIZE=256
# CT_MAX_BATCH_SIZE=1024
# CT_HTTP_TIMEOUT_SECONDS=30
# CT_STATS_HEAVY_REFRESH_SECONDS=300
# CT_MAINTENANCE_INTERVAL_SECONDS=3600
