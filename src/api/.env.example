# Required
DATABASE_URL=postgresql+psycopg://ctpool:CHANGEME@localhost:5432/ctpool

# Application metadata (optional — defaults shown)
# APP_NAME=BitsyCerts API
# APP_VERSION=0.1.0

# Pagination defaults (optional)
# DEFAULT_PAGE_LIMIT=50
# MAX_PAGE_LIMIT=200

# Operational stats exposure (optional — default shown)
# Enabled by default because the bundled dashboard reads /v1/stats.
# Set false only for unusual deployments behind a gateway or external auth.
# BITSYSCERTS_EXPOSE_STATS_API=true
